# Configuración del Entorno de Ejecución
NODE_ENV=development
PORT=3000

# Configuración de la API
API_PREFIX=/api/v1

# Seguridad y CORS
# Para múltiples orígenes separar por comas: http://localhost:3000,http://localhost:5173
CORS_ORIGIN=*

# Rate Limiting (Peticiones por ventana de tiempo)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Base de Datos (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=administrador_retiros_rcc
DB_CONNECTION_LIMIT=10

# Autenticación JWT
JWT_SECRET=super_secret_jwt_key_rcc_retreats_change_in_production
JWT_EXPIRES_IN=24h

# Usuario Inicial con Máximos Privilegios (Rol: root)
# Se crea automáticamente en el primer arranque del servidor si no existe un usuario root
ROOT_ADMIN_NAME=Super Administrador RCC
ROOT_ADMIN_USER=rootadmin
ROOT_ADMIN_EMAIL=admin@retirosrcc.com
ROOT_ADMIN_PASSWORD=Admin123*
